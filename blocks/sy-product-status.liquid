{%- doc -%}
  SY product status for the product details column. Shows the one-of-one note (or the
  sold message with a Sold Archive link), a condition summary that links to the full
  condition section, the fulfilment line (shippable or local pickup only) and an
  "Ask about this piece" link that pre-fills the contact form.

  @example
  {% content_for 'block', type: 'sy-product-status', id: 'sy-status', closest.product: product %}
{%- enddoc -%}
{%- render 'sy-base' -%}
{%- liquid
  assign product = closest.product
  assign bs = block.settings

  assign grade = product.metafields.custom.condition_grade.value
  assign fulfilment = product.metafields.custom.fulfillment.value | default: product.metafields.custom.shipping_class.value
  assign fulfilment_down = fulfilment | downcase
  assign pickup_only = false
  if fulfilment_down contains 'pickup'
    assign pickup_only = true
  endif

  assign ask_title = product.title | url_encode
  assign ask_url = bs.ask_page.url | default: '/pages/contact'
  assign ask_url = ask_url | append: '?product=' | append: ask_title
-%}
<div class="sy-scheme--cream sy-pstatus" {{ block.shopify_attributes }}>
  {%- if product.available -%}
    {%- if bs.available_text != blank -%}
      <p class="sy-pstatus__line">
        <span class="sy-pstatus__dot" aria-hidden="true"></span>
        {{- bs.available_text | escape -}}
      </p>
    {%- endif -%}
  {%- else -%}
    <div class="sy-pstatus__sold">
      <span class="sy-card__badge sy-pstatus__badge">{{ settings.sy_sold_label | escape }}</span>
      {%- if bs.sold_text != blank -%}
        <p class="sy-pstatus__sold-text">{{ bs.sold_text | escape }}</p>
      {%- endif -%}
      {%- if bs.archive_label != blank -%}
        <a class="sy-link" href="{{ bs.archive_link | default: '/collections/sold-archive' }}">
          {{- bs.archive_label | escape -}}
          <span class="sy-link__arrow" aria-hidden="true">&rarr;</span>
        </a>
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if bs.show_condition and grade != blank -%}
    <p class="sy-pstatus__row">
      <span class="sy-eyebrow">{{ 'sy.product.condition' | t }}</span>
      <span>{{ grade | escape }}</span>
      {%- if bs.condition_link_label != blank -%}
        <a href="#sy-condition" class="sy-pstatus__anchor">{{ bs.condition_link_label | escape }}</a>
      {%- endif -%}
    </p>
  {%- endif -%}

  {%- if bs.show_fulfilment and product.available -%}
    <p class="sy-pstatus__row sy-pstatus__fulfil">
      {%- if pickup_only -%}
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M12 21s-7-6.2-7-11.5A7 7 0 0 1 19 9.5C19 14.8 12 21 12 21Z"/><circle cx="12" cy="9.5" r="2.5"/></svg>
        <span>{{ bs.pickup_text | escape }}</span>
      {%- else -%}
        <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M3 7.5 12 3l9 4.5v9L12 21l-9-4.5v-9Z"/><path d="m3 7.5 9 4.5 9-4.5M12 12v9"/></svg>
        <span>{{ bs.shipping_text | escape }}</span>
      {%- endif -%}
    </p>
  {%- endif -%}

  {%- if bs.ask_label != blank -%}
    <a class="sy-btn sy-btn--outline sy-pstatus__ask" href="{{ ask_url }}">{{ bs.ask_label | escape }}</a>
  {%- endif -%}
</div>

{% stylesheet %}
  .sy-pstatus {
    display: flex;
    flex-direction: column;
    gap: 14px;
    width: 100%;
    color: var(--sy-fg);
    font-family: var(--sy-font-body);
  }

  .sy-pstatus__line {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 15px;
  }

  .sy-pstatus__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--sy-gold);
    flex: none;
  }

  .sy-pstatus__sold {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
    padding: 18px 20px;
    border: 1px solid var(--sy-line);
    border-radius: var(--sy-radius);
  }

  .sy-pstatus .sy-pstatus__badge {
    position: static;
  }

  .sy-pstatus__sold-text {
    margin: 0;
    font-family: var(--sy-font-heading);
    font-size: 20px;
    font-style: italic;
  }

  .sy-pstatus__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 12px;
    margin: 0;
    padding-block-start: 14px;
    border-block-start: 1px solid var(--sy-line);
    font-size: 15px;
  }

  .sy-pstatus__anchor {
    color: var(--sy-muted);
    font-size: 14px;
    text-decoration: underline;
    text-decoration-color: var(--sy-accent);
    text-underline-offset: 3px;
  }

  .sy-pstatus__fulfil svg {
    flex: none;
    color: var(--sy-accent);
  }

  .sy-pstatus__ask {
    width: 100%;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SY Product status",
  "tag": null,
  "settings": [
    { "type": "header", "content": "Availability" },
    { "type": "text", "id": "available_text", "label": "One-of-one note", "default": "One of one — only one available" },
    { "type": "text", "id": "sold_text", "label": "Sold message", "default": "This piece has found a home." },
    { "type": "text", "id": "archive_label", "label": "Sold Archive link label", "default": "Browse the Sold Archive" },
    { "type": "url", "id": "archive_link", "label": "Sold Archive link" },
    { "type": "header", "content": "Condition" },
    { "type": "checkbox", "id": "show_condition", "label": "Show condition grade", "default": true, "info": "Metafield custom.condition_grade" },
    { "type": "text", "id": "condition_link_label", "label": "Condition link label", "default": "See condition notes" },
    { "type": "header", "content": "Fulfilment" },
    { "type": "checkbox", "id": "show_fulfilment", "label": "Show shipping / pickup line", "default": true, "info": "Metafield custom.fulfillment: 'Shippable' or 'Local Pickup Only'" },
    { "type": "text", "id": "shipping_text", "label": "Shippable text", "default": "Ships within the contiguous US · tracked & insured" },
    { "type": "text", "id": "pickup_text", "label": "Local pickup only text", "default": "Local pickup only — Sebastian, Florida" },
    { "type": "header", "content": "Ask about this piece" },
    { "type": "text", "id": "ask_label", "label": "Button label", "default": "Ask about this piece" },
    { "type": "page", "id": "ask_page", "label": "Contact page", "info": "The product name is pre-filled in the contact form." }
  ],
  "presets": [{ "name": "SY Product status" }]
}
{% endschema %}
