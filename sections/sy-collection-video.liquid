{%- liquid
  assign s = section.settings
  assign editorial_video = collection.metafields.custom.editorial_video.value | default: s.video
-%}
{%- if editorial_video != blank -%}
  {%- render 'sy-base' -%}
  <section
    id="sy-{{ section.id }}"
    class="sy-section sy-scheme--{{ s.color_scheme }} sy-cvideo sy-cvideo--{{ s.layout }}"
    style="{% render 'sy-section-style', settings: s %} --sy-h-d: {{ s.heading_size }}px; --sy-h-m: {{ s.heading_size_mobile }}px; --sy-media-ratio: {{ s.ratio }};"
  >
    <div class="sy-container{% if s.content_width == 'full' %} sy-container--full{% endif %}{% if settings.sy_reveal and s.reveal %} sy-reveal{% endif %}">
      <div class="sy-cvideo__inner">
        {%- if s.heading != blank or s.text != blank -%}
          <div class="sy-cvideo__text">
            {%- if s.eyebrow != blank -%}
              <div>
                <p class="sy-eyebrow">{{ s.eyebrow | escape }}</p>
                <span class="sy-rule" aria-hidden="true"></span>
              </div>
            {%- endif -%}
            {%- if s.heading != blank -%}<h2 class="sy-heading">{{ s.heading }}</h2>{%- endif -%}
            {%- if s.text != blank -%}<div class="sy-text">{{ s.text }}</div>{%- endif -%}
          </div>
        {%- endif -%}
        <div class="sy-cvideo__media sy-media sy-media--ratio">
          {%- if s.autoplay -%}
            {{ editorial_video | video_tag: autoplay: true, loop: true, muted: true, playsinline: true, controls: false, preload: 'metadata', image_size: '1600x' }}
          {%- else -%}
            {{ editorial_video | video_tag: controls: true, playsinline: true, preload: 'none', image_size: '1600x' }}
          {%- endif -%}
        </div>
      </div>
    </div>
  </section>


{%- endif -%}

{% stylesheet %}
  .sy-cvideo__inner {
    display: grid;
    gap: 36px;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .sy-cvideo--split .sy-cvideo__inner {
      grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
      gap: clamp(48px, 6vw, 96px);
    }
  }

  .sy-cvideo__text {
    display: flex;
    flex-direction: column;
    gap: 18px;
  }

  .sy-cvideo--full .sy-cvideo__text {
    max-width: 40rem;
  }

  .sy-cvideo__media video {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SY Collection video",
  "tag": "div",
  "enabled_on": {
    "templates": [
      "collection"
    ]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows only when a video exists. Add one to the collection's custom.editorial_video metafield (so each collection has its own) or choose one here."
    },
    {
      "type": "video",
      "id": "video",
      "label": "Fallback video"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "split",
          "label": "Text beside video"
        },
        {
          "value": "full",
          "label": "Text above video"
        }
      ],
      "default": "split"
    },
    {
      "type": "select",
      "id": "ratio",
      "label": "Video shape",
      "options": [
        {
          "value": "16 / 9",
          "label": "Widescreen 16:9"
        },
        {
          "value": "4 / 3",
          "label": "4:3"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait 4:5"
        }
      ],
      "default": "16 / 9"
    },
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Autoplay muted on loop",
      "default": true,
      "info": "Turn off for videos with sound; visitors then press play."
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "In motion"
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A closer <em>look</em>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 80,
      "step": 2,
      "unit": "px",
      "default": 44
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text"
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sage",
          "label": "Light sage"
        },
        {
          "value": "forest",
          "label": "Forest green (dark)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "forest",
      "info": "Brand colours are set in Theme settings > Subjectively Yours."
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Background",
      "default": "#F5EDE1",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Text",
      "default": "#41523F",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_muted",
      "label": "Secondary text",
      "default": "#5B4632",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Accent rules",
      "default": "#B88D46",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "Button background",
      "default": "#41523F",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "Button text",
      "default": "#F5EDE1",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_card_background",
      "label": "Image background",
      "default": "#EFE6D8",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "page",
          "label": "Brand width"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 120
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 72
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": true,
      "info": "Also needs Theme settings > Subjectively Yours > Reveal sections on scroll."
    }
  ],
  "presets": [
    {
      "name": "SY Collection video"
    }
  ]
}
{% endschema %}
