{%- render 'sy-base' -%}
<section
  id="sy-{{ section.id }}"
  class="sy-section sy-scheme--{{ section.settings.color_scheme }} sy-gallery-section"
  style="{% render 'sy-section-style', settings: section.settings %}"
>
  <div class="sy-container{% if section.settings.content_width == 'full' %} sy-container--full{% endif %}{% if settings.sy_reveal and section.settings.reveal %} sy-reveal{% endif %}">

    {%- assign s = section.settings -%}
    {%- render 'sy-section-heading', settings: s -%}
    <div
      class="sy-grid sy-gallery{% if s.hover_zoom %} sy-gallery--zoom{% endif %}"
      style="--sy-cols-d: {{ s.columns_desktop }}; --sy-cols-m: {{ s.columns_mobile }}; --sy-gap: {{ s.gap }}px; --sy-gap-x: {{ s.gap }}px; --sy-gap-m: 8px; --sy-gap-x-m: 8px; --sy-media-ratio: {{ s.image_ratio }};"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign img = block.settings.image
          assign link = block.settings.link | default: s.link_url
          assign demo_image = ''
          if forloop.index <= 6
            assign demo_image = 'sy-demo-insta-0' | append: forloop.index | append: '.jpg'
          endif
          assign gallery_style = 'object-position: ' | append: img.presentation.focal_point
          assign gallery_alt = block.settings.alt | default: img.alt
        -%}
        {%- if link != blank -%}
          <a class="sy-gallery__item sy-media sy-media--ratio" href="{{ link }}" target="_blank" rel="noopener" {{ block.shopify_attributes }}>
        {%- else -%}
          <div class="sy-gallery__item sy-media sy-media--ratio" {{ block.shopify_attributes }}>
        {%- endif -%}
          {%- if img != blank -%}
            {{ img | image_url: width: 800 | image_tag: widths: '300, 500, 800', sizes: '(min-width: 990px) 25vw, 50vw', loading: 'lazy', alt: gallery_alt, style: gallery_style }}
          {%- elsif demo_image != blank -%}
            <img src="{{ demo_image | asset_url }}" alt="" loading="lazy" width="1200" height="1200">
          {%- else -%}
            {{ 'image' | placeholder_svg_tag }}
          {%- endif -%}
          {%- if link != blank -%}
            <span class="sy-visually-hidden">{{ s.link_label | default: 'Instagram' | escape }}</span>
          {%- endif -%}
        {%- if link != blank -%}
          </a>
        {%- else -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .sy-gallery__item {
    display: block;
  }

  .sy-gallery__item img {
    transition: transform 0.8s ease, opacity 0.3s ease;
  }

  @media (hover: hover) {
    .sy-gallery--zoom .sy-gallery__item:hover img {
      transform: scale(1.05);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SY Image gallery",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Heading"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow label",
      "default": "Follow along"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show gold rule under label",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "From the <em>hunt</em>",
      "info": "Use italic for an accent word."
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
      "min": 24,
      "max": 96,
      "step": 2,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading size (mobile)",
      "min": 20,
      "max": 64,
      "step": 2,
      "unit": "px",
      "default": 34
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Instagram"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "header",
      "content": "Gallery"
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Columns (desktop)",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "select",
      "id": "columns_mobile",
      "label": "Columns (mobile)",
      "options": [
        {
          "value": "2",
          "label": "2"
        },
        {
          "value": "3",
          "label": "3"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall (3:4)"
        }
      ],
      "default": "1 / 1"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "Gap (desktop)",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "checkbox",
      "id": "hover_zoom",
      "label": "Zoom on hover",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sage",
          "label": "Light sage"
        },
        {
          "value": "forest",
          "label": "Forest green (dark)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "cream",
      "info": "Brand colours are set in Theme settings > Subjectively Yours."
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Background",
      "default": "#F5EDE1",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Text",
      "default": "#41523F",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_muted",
      "label": "Secondary text",
      "default": "#5B4632",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Accent rules",
      "default": "#B88D46",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "Button background",
      "default": "#41523F",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "Button text",
      "default": "#F5EDE1",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_card_background",
      "label": "Image background",
      "default": "#EFE6D8",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Section layout"
