{%- render 'sy-base' -%}
<section
  id="sy-{{ section.id }}"
  class="sy-section sy-scheme--{{ section.settings.color_scheme }} sy-collection-tiles"
  style="{% render 'sy-section-style', settings: section.settings %}"
>
  <div class="sy-container{% if section.settings.content_width == 'full' %} sy-container--full{% endif %}{% if settings.sy_reveal and section.settings.reveal %} sy-reveal{% endif %}">

    {%- liquid
      assign s = section.settings
      assign overlay = s.overlay_opacity | divided_by: 100.0
    -%}
    {%- render 'sy-section-heading', settings: s -%}
    <div
      class="sy-grid sy-tiles sy-tiles--label-{{ s.label_position }}{% if s.hover_zoom %} sy-tiles--zoom{% endif %}"
      style="--sy-cols-d: {{ s.columns_desktop }}; --sy-cols-m: {{ s.columns_mobile }}; --sy-gap: {{ s.gap }}px; --sy-gap-x: {{ s.gap }}px; --sy-gap-m: 16px; --sy-gap-x-m: 12px; --sy-media-ratio: {{ s.tile_ratio }}; --sy-tile-label: {{ s.label_size }}px; --sy-tile-label-m: {{ s.label_size_mobile }}px; --sy-tile-ov: {{ overlay }}; --sy-tile-text: {{ s.label_color }};"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign col = block.settings.collection
          assign title = block.settings.title | default: col.title
          assign link = block.settings.link | default: col.url
          assign img = block.settings.image | default: col.featured_image
          assign demo_image = block.settings.demo_image
          if demo_image == blank and forloop.index <= 6
            assign demo_image = 'sy-demo-cat-0' | append: forloop.index | append: '.jpg'
          endif
          assign tile_style = 'object-position: ' | append: img.presentation.focal_point
        -%}
        <a class="sy-tile" href="{{ link | default: '#' }}" {{ block.shopify_attributes }}>
          <div class="sy-tile__media sy-media sy-media--ratio">
            {%- if img != blank -%}
              {{
                img
                | image_url: width: 1400
                | image_tag:
                  widths: '400, 600, 800, 1000, 1400',
                  sizes: '(min-width: 990px) 33vw, (min-width: 750px) 50vw, 50vw',
                  loading: 'lazy',
                  alt: title,
                  style: tile_style
              }}
            {%- elsif demo_image != blank -%}
              <img src="{{ demo_image | asset_url }}" alt="{{ title | escape }}" loading="lazy" width="1500" height="1000">
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag }}
            {%- endif -%}
            {%- if s.label_position == 'overlay' and title != blank -%}
              <span class="sy-tile__shade" aria-hidden="true"></span>
              <span class="sy-tile__label">{{ title | escape }}</span>
            {%- endif -%}
          </div>
          {%- if s.label_position == 'below' and title != blank -%}
            <span class="sy-tile__label sy-tile__label--below">{{ title | escape }}</span>
          {%- endif -%}
          {%- if s.show_description and block.settings.description != blank -%}
            <span class="sy-tile__desc">{{ block.settings.description | escape }}</span>
          {%- endif -%}
        </a>
      {%- endfor -%}
    </div>

  </div>
</section>

{% stylesheet %}
  .sy-tile {
    display: flex;
    flex-direction: column;
    gap: 14px;
    min-width: 0;
    color: var(--sy-fg);
    text-decoration: none;
  }

  .sy-tile__media img {
    transition: transform 1s ease;
  }

  @media (hover: hover) {
    .sy-tiles--zoom .sy-tile:hover .sy-tile__media img {
      transform: scale(1.04);
    }
  }

  .sy-tile__shade {
    position: absolute;
    inset: 0;
    background: linear-gradient(0deg, rgb(0 0 0 / var(--sy-tile-ov)) 0%, transparent 55%);
    pointer-events: none;
  }

  .sy-tile__label {
    font-family: var(--sy-font-label);
    font-size: var(--sy-tile-label-m);
    letter-spacing: 0.12em;
    line-height: 1;
    text-transform: uppercase;
  }

  @media screen and (min-width: 750px) {
    .sy-tile__label {
      font-size: var(--sy-tile-label);
    }
  }

  .sy-tile__media .sy-tile__label {
    position: absolute;
    inset-inline-start: clamp(14px, 4%, 28px);
    inset-block-end: clamp(14px, 6%, 28px);
    color: var(--sy-tile-text);
  }

  .sy-tile__label--below {
    color: var(--sy-fg);
  }

  .sy-tile__desc {
    font-family: var(--sy-font-body);
    font-size: 14px;
    line-height: 1.45;
    color: var(--sy-fg);
  }

  @media screen and (min-width: 750px) {
    .sy-tile__desc {
      font-size: 16px;
    }
  }
{% endstylesheet %}

