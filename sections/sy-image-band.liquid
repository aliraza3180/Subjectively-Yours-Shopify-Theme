{%- render 'sy-base' -%}
{%- liquid
  assign s = section.settings
  assign img = s.image
  assign img_style = 'object-position: ' | append: img.presentation.focal_point
  assign overlay = s.overlay_opacity | divided_by: 100.0
-%}
<section
  id="sy-{{ section.id }}"
  class="sy-band sy-band--{{ s.caption_position }}"
  style="--sy-band-h: {{ s.height }}svh; --sy-band-h-m: {{ s.height_mobile }}svh; --sy-band-ov: {{ overlay }}; --sy-band-text: {{ s.text_color }};"
>
  <div class="sy-band__media">
    {%- if img != blank -%}
      <picture>
        {%- if s.image_mobile != blank -%}
          <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
        {%- endif -%}
        {{ img | image_url: width: 3000 | image_tag: widths: '750, 1100, 1500, 2000, 2600, 3000', sizes: '100vw', loading: 'lazy', alt: img.alt, style: img_style }}
      </picture>
    {%- elsif s.demo_image != blank -%}
      <img src="{{ s.demo_image | asset_url }}" alt="" loading="lazy" width="2400" height="1600">
    {%- else -%}
      {{ 'image' | placeholder_svg_tag }}
    {%- endif -%}
  </div>
  {%- if s.caption != blank -%}
    <span class="sy-band__shade" aria-hidden="true"></span>
    <div class="sy-band__caption">
      <div class="sy-container">
        <p class="sy-band__text">{{ s.caption }}</p>
      </div>
    </div>
  {%- endif -%}
</section>

{% stylesheet %}
  .sy-band {
    --sy-gutter: var(--sy-gutter-mobile);
    position: relative;
    display: flex;
    min-height: var(--sy-band-h-m);
    overflow: hidden;
    background: var(--sy-forest);
  }

  @media screen and (min-width: 750px) {
    .sy-band {
      --sy-gutter: var(--sy-gutter-desktop);
      min-height: var(--sy-band-h);
    }
  }

  .sy-band__media,
  .sy-band__media img,
  .sy-band__media picture,
  .sy-band__media svg,
  .sy-band__shade {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .sy-band__shade {
    background: linear-gradient(0deg, rgb(0 0 0 / var(--sy-band-ov)) 0%, transparent 55%);
  }

  .sy-band__caption {
    position: relative;
    z-index: 1;
    display: flex;
    align-items: flex-end;
    width: 100%;
    padding-block: 48px;
  }

  .sy-band--center .sy-band__caption {
    text-align: center;
  }

  .sy-band__text {
    max-width: 32rem;
    margin: 0;
    font-family: var(--sy-font-heading);
    font-size: clamp(22px, 2.6vw, 34px);
    font-style: italic;
    line-height: 1.3;
    color: var(--sy-band-text);
  }

  .sy-band--center .sy-band__text {
    margin-inline: auto;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SY Image band",
  "tag": "div",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Wide image, at least 2400px across."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Image (mobile, optional)"
    },
    {
      "type": "select",
      "id": "demo_image",
      "label": "Placeholder (until an image is chosen)",
      "options": [
        {
          "value": "",
          "label": "None"
        },
        {
          "value": "sy-demo-about-hero.jpg",
          "label": "About hero"
        },
        {
          "value": "sy-demo-about-chair.jpg",
          "label": "About chair"
        },
        {
          "value": "sy-demo-about-band.jpg",
          "label": "About band"
        },
        {
          "value": "sy-demo-about-table.jpg",
          "label": "About table"
        },
        {
          "value": "sy-demo-about-vase.jpg",
          "label": "About vase"
        },
        {
          "value": "sy-demo-about-teaset.jpg",
          "label": "About teaset"
        },
        {
          "value": "sy-demo-collector.jpg",
          "label": "Collector"
        },
        {
          "value": "sy-demo-enamel-feature.jpg",
          "label": "Enamel feature"
        },
        {
          "value": "sy-demo-hero.jpg",
          "label": "Hero"
        }
      ],
      "default": ""
    },
    {
      "type": "range",
      "id": "height",
      "label": "Height (desktop)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 75
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Height (mobile)",
      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "default": 55
    },
    {
      "type": "inline_richtext",
      "id": "caption",
      "label": "Caption (italic, optional)"
    },
    {
      "type": "select",
      "id": "caption_position",
      "label": "Caption position",
      "options": [
        {
          "value": "left",
          "label": "Bottom left"
        },
        {
          "value": "center",
          "label": "Bottom centre"
        }
      ],
      "default": "left"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Caption colour",
      "default": "#F5EDE1"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Shade behind caption",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 55
    }
  ],
  "presets": [
    {
      "name": "SY Image band"
    }
  ],
  "disabled_on": {
    "groups": [
      "header"
    ]
  }
}
{% endschema %}
