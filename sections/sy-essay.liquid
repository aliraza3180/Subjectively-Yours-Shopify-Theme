{%- render 'sy-base' -%}
{%- assign s = section.settings -%}
<section
  id="sy-{{ section.id }}"
  class="sy-section sy-scheme--{{ s.color_scheme }} sy-essay"
  style="{% render 'sy-section-style', settings: s %} --sy-essay-w: {{ s.text_width }}px; --sy-essay-size: {{ s.text_size }}px;"
>
  <div class="sy-container{% if s.content_width == 'full' %} sy-container--full{% endif %}">
    <div class="sy-essay__flow{% if s.drop_cap %} sy-essay--dropcap{% endif %}">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'text' -%}
            <div class="sy-essay__text sy-text" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
          {%- when 'heading' -%}
            <h2 class="sy-heading sy-essay__heading" {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
          {%- when 'image' -%}
            {%- liquid
              assign img = block.settings.image
              assign img_style = 'object-position: ' | append: img.presentation.focal_point
              assign demo = block.settings.demo_image
            -%}
            <figure class="sy-essay__figure sy-essay__figure--{{ block.settings.size }}" style="--sy-media-ratio: {{ block.settings.ratio }};" {{ block.shopify_attributes }}>
              <div class="sy-media sy-media--ratio">
                {%- if img != blank -%}
                  {{ img | image_url: width: 2000 | image_tag: widths: '500, 800, 1100, 1500, 2000', sizes: '(min-width: 990px) 70vw, 100vw', loading: 'lazy', alt: img.alt, style: img_style }}
                {%- elsif demo != blank -%}
                  <img src="{{ demo | asset_url }}" alt="" loading="lazy" width="800" height="800">
                {%- else -%}
                  {{ 'image' | placeholder_svg_tag }}
                {%- endif -%}
              </div>
              {%- if block.settings.caption != blank -%}
                <figcaption>{{ block.settings.caption | escape }}</figcaption>
              {%- endif -%}
            </figure>
          {%- when 'image_pair' -%}
            <div class="sy-essay__pair" {{ block.shopify_attributes }}>
              {%- for i in (1..2) -%}
                {%- liquid
                  if i == 1
                    assign img = block.settings.image_1
                    assign demo = block.settings.demo_image_1
                  else
                    assign img = block.settings.image_2
                    assign demo = block.settings.demo_image_2
                  endif
                -%}
                <div class="sy-media sy-media--ratio" style="--sy-media-ratio: 4 / 5;">
                  {%- if img != blank -%}
                    {{ img | image_url: width: 1200 | image_tag: widths: '400, 700, 1000, 1200', sizes: '(min-width: 990px) 35vw, 50vw', loading: 'lazy', alt: img.alt }}
                  {%- elsif demo != blank -%}
                    <img src="{{ demo | asset_url }}" alt="" loading="lazy" width="600" height="750">
                  {%- else -%}
                    {{ 'image' | placeholder_svg_tag }}
                  {%- endif -%}
                </div>
              {%- endfor -%}
              {%- if block.settings.caption != blank -%}
                <p class="sy-essay__pair-caption">{{ block.settings.caption | escape }}</p>
              {%- endif -%}
            </div>
          {%- when 'quote' -%}
            <blockquote class="sy-essay__quote" {{ block.shopify_attributes }}>
              <p>{{ block.settings.quote }}</p>
            </blockquote>
          {%- when 'signature' -%}
            <div class="sy-essay__signature" {{ block.shopify_attributes }}>
              {%- if block.settings.signoff != blank -%}<p class="sy-essay__signoff">{{ block.settings.signoff | escape }}</p>{%- endif -%}
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 600 | image_tag: widths: '200, 400, 600', sizes: '240px', loading: 'lazy', alt: block.settings.name }}
              {%- elsif block.settings.name != blank -%}
                <p class="sy-essay__name">{{ block.settings.name | escape }}</p>
              {%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .sy-essay__flow {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 40px;
  }

  .sy-essay__text,
  .sy-essay__heading,
  .sy-essay__quote,
  .sy-essay__signature {
    width: 100%;
    max-width: var(--sy-essay-w);
  }

  .sy-essay__text {
    font-size: calc(var(--sy-essay-size) * 0.94);
    line-height: 1.8;
  }

  @media screen and (min-width: 750px) {
    .sy-essay__text {
      font-size: var(--sy-essay-size);
    }
  }

  .sy-essay--dropcap .sy-essay__text:first-child > p:first-child::first-letter {
    float: left;
    margin: 0.08em 0.12em 0 0;
    font-family: var(--sy-font-heading);
    font-size: 4.2em;
    line-height: 0.8;
    color: var(--sy-fg);
  }

  .sy-essay__heading {
    --sy-h-d: 40px;
    --sy-h-m: 30px;
  }

  .sy-essay__figure {
    width: 100%;
    margin: 16px 0;
  }

  .sy-essay__figure--inset {
    max-width: var(--sy-essay-w);
  }

  .sy-essay__figure--wide {
    max-width: calc(var(--sy-essay-w) + 320px);
  }

  .sy-essay__figure figcaption,
  .sy-essay__pair-caption {
    margin-block-start: 12px;
    font-family: var(--sy-font-body);
    font-size: 14px;
    font-style: italic;
    color: var(--sy-muted);
  }

  .sy-essay__pair {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    width: 100%;
    max-width: calc(var(--sy-essay-w) + 320px);
    margin-block: 16px;
  }

  .sy-essay__pair-caption {
    grid-column: 1 / -1;
    margin: 0;
  }

  .sy-essay__quote {
    margin: 24px 0;
    padding-inline-start: 28px;
    border-inline-start: 1px solid var(--sy-accent);
  }

  .sy-essay__quote p {
    margin: 0;
    font-family: var(--sy-font-heading);
    font-size: clamp(26px, 3.2vw, 40px);
    font-style: italic;
    line-height: 1.25;
    color: var(--sy-fg);
  }

  .sy-essay__signature {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .sy-essay__signature img {
    width: 200px;
    height: auto;
  }

  .sy-essay__signoff {
    margin: 0;
    font-family: var(--sy-font-label);
    font-size: 14px;
    letter-spacing: var(--sy-label-spacing);
    text-transform: uppercase;
  }

  .sy-essay__name {
    margin: 0;
    font-family: var(--sy-font-heading);
    font-size: 30px;
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
