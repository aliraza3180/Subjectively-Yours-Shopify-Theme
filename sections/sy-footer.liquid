{%- render 'sy-base' -%}
{%- assign s = section.settings -%}
<footer
  id="sy-{{ section.id }}"
  class="sy-section sy-scheme--{{ s.color_scheme }} sy-footer"
  style="{% render 'sy-section-style', settings: s %} --sy-footer-logo: {{ s.logo_width }}px; --sy-footer-cols: {{ section.blocks.size | at_least: 1 }};"
>
  <div class="sy-container{% if s.content_width == 'full' %} sy-container--full{% endif %}">
    <div class="sy-footer__top">
      <div class="sy-footer__brand">
        {%- if s.show_logo -%}
          <a href="{{ routes.root_url }}" class="sy-footer__logo">
            {%- if s.logo != blank -%}
              {{ s.logo | image_url: width: 600 | image_tag: widths: '200, 300, 400, 600', sizes: '200px', loading: 'lazy', alt: shop.name }}
            {%- else -%}
              <img src="{{ 'sy-seal.png' | asset_url }}" alt="{{ shop.name | escape }}" loading="lazy" width="360" height="360">
            {%- endif -%}
          </a>
        {%- endif -%}
        {%- if s.brand_text != blank -%}
          <div class="sy-text sy-footer__brand-text">{{ s.brand_text }}</div>
        {%- endif -%}
        {%- liquid
          assign has_social = false
          if s.instagram_url != blank or s.facebook_url != blank or s.pinterest_url != blank or s.tiktok_url != blank
            assign has_social = true
          endif
        -%}
        {%- if has_social -%}
          <ul class="sy-footer__social" role="list">
            {%- if s.instagram_url != blank -%}
              <li><a href="{{ s.instagram_url }}" target="_blank" rel="noopener" aria-label="Instagram"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.4"><rect x="3" y="3" width="18" height="18" rx="5"/><circle cx="12" cy="12" r="4.2"/><circle cx="17.4" cy="6.6" r="0.9" fill="currentColor" stroke="none"/></svg></a></li>
            {%- endif -%}
            {%- if s.facebook_url != blank -%}
              <li><a href="{{ s.facebook_url }}" target="_blank" rel="noopener" aria-label="Facebook"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M13.5 21v-7.5h2.6l.4-3h-3V8.6c0-.9.3-1.5 1.5-1.5h1.6V4.4c-.3 0-1.2-.1-2.3-.1-2.3 0-3.9 1.4-3.9 4v2.2H7.8v3h2.6V21h3.1Z"/></svg></a></li>
            {%- endif -%}
            {%- if s.pinterest_url != blank -%}
              <li><a href="{{ s.pinterest_url }}" target="_blank" rel="noopener" aria-label="Pinterest"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M12 2.5a9.5 9.5 0 0 0-3.46 18.35c-.08-.75-.16-1.9.03-2.72l1.13-4.8s-.29-.58-.29-1.43c0-1.34.78-2.34 1.75-2.34.82 0 1.22.62 1.22 1.36 0 .83-.53 2.07-.8 3.22-.23.96.48 1.75 1.43 1.75 1.72 0 3.04-1.81 3.04-4.43 0-2.32-1.67-3.94-4.04-3.94-2.75 0-4.37 2.06-4.37 4.2 0 .83.32 1.72.72 2.2.08.1.09.18.07.28l-.27 1.1c-.04.18-.14.22-.33.13-1.22-.57-1.98-2.35-1.98-3.78 0-3.08 2.24-5.9 6.45-5.9 3.38 0 6.01 2.41 6.01 5.63 0 3.36-2.12 6.07-5.06 6.07-.99 0-1.92-.51-2.24-1.12l-.61 2.32c-.22.85-.82 1.91-1.22 2.56A9.5 9.5 0 1 0 12 2.5Z"/></svg></a></li>
            {%- endif -%}
            {%- if s.tiktok_url != blank -%}
              <li><a href="{{ s.tiktok_url }}" target="_blank" rel="noopener" aria-label="TikTok"><svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M16.6 3h-3.1v12.3a2.7 2.7 0 1 1-2.7-2.7c.3 0 .5 0 .8.1V9.5a5.9 5.9 0 1 0 5 5.8V9.1a7.6 7.6 0 0 0 4.3 1.3V7.3a4.4 4.4 0 0 1-4.3-4.3Z"/></svg></a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
      </div>

      <div class="sy-footer__cols">
        {%- for block in section.blocks -%}
          <div class="sy-footer__col" {{ block.shopify_attributes }}>
            {%- if block.settings.title != blank -%}
              <p class="sy-eyebrow sy-footer__title">{{ block.settings.title | escape }}</p>
              {%- if s.show_rules -%}
                <span class="sy-rule" aria-hidden="true"></span>
              {%- endif -%}
            {%- endif -%}
            {%- case block.type -%}
              {%- when 'menu' -%}
                {%- if block.settings.menu.links.size > 0 -%}
                  <ul class="sy-footer__links" role="list">
                    {%- for link in block.settings.menu.links -%}
                      <li><a href="{{ link.url }}">{{ link.title | escape }}</a></li>
                    {%- endfor -%}
                  </ul>
                {%- endif -%}
              {%- when 'text' -%}
                <div class="sy-text sy-footer__rte">{{ block.settings.text }}</div>
            {%- endcase -%}
          </div>
        {%- endfor -%}
      </div>
    </div>

    <div class="sy-footer__bottom">
      <p class="sy-footer__small">
        &copy; {{ 'now' | date: '%Y' }}
        {{ s.copyright_text | default: shop.name | escape }}
      </p>
      {%- if s.tagline != blank -%}
        <p class="sy-footer__tagline">{{ s.tagline | escape }}</p>
      {%- endif -%}
      {%- if s.show_policies -%}
        <ul class="sy-footer__policies" role="list">
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <li><a href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
            {%- endif -%}
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
    {%- if s.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
      <ul class="sy-footer__payments" role="list">
        {%- for type in shop.enabled_payment_types -%}
          <li>{{ type | payment_type_svg_tag }}</li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</footer>

{% stylesheet %}
  .sy-footer__top {
    display: grid;
    gap: 48px;
  }

  @media screen and (min-width: 990px) {
    .sy-footer__top {
      grid-template-columns: minmax(200px, 0.9fr) 3fr;
      gap: 64px;
    }
  }

  .sy-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  .sy-footer__logo {
    display: block;
    width: var(--sy-footer-logo);
    max-width: 100%;
  }

  .sy-footer__logo img {
    display: block;
    width: 100%;
    height: auto;
  }

  .sy-footer__brand-text {
    max-width: 22rem;
    font-size: 15px;
  }

  .sy-footer__social {
    display: flex;
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sy-footer__social a {
    display: inline-flex;
    color: var(--sy-fg);
    transition: color 0.2s ease;
  }

  .sy-footer__social a:hover {
    color: var(--sy-accent);
  }

  .sy-footer__cols {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 40px 24px;
  }

  @media screen and (min-width: 750px) {
    .sy-footer__cols {
      grid-template-columns: repeat(min(var(--sy-footer-cols), 4), minmax(0, 1fr));
    }
  }

  .sy-footer__title {
    margin: 0;
  }

  .sy-footer__links {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 20px 0 0;
    padding: 0;
    list-style: none;
  }

  .sy-footer__links a,
  .sy-footer__policies a {
    color: var(--sy-fg);
    font-family: var(--sy-font-body);
    font-size: 16px;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .sy-footer__links a:hover,
  .sy-footer__policies a:hover {
    color: var(--sy-accent);
  }

  .sy-footer__rte {
    margin-block-start: 20px;
    font-size: 15px;
  }

  .sy-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-block-start: 56px;
    padding-block-start: 28px;
    border-block-start: 1px solid var(--sy-accent);
  }

  .sy-footer__small {
    margin: 0;
    font-size: 14px;
  }

  .sy-footer__tagline {
    margin: 0;
    font-family: var(--sy-font-heading);
    font-size: 22px;
    font-style: italic;
  }

  .sy-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .sy-footer__policies a {
    font-family: var(--sy-font-label);
    font-size: 11px;
    letter-spacing: var(--sy-label-spacing);
    text-transform: uppercase;
  }

  .sy-footer__payments {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 24px 0 0;
    padding: 0;
    list-style: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SY Footer",
  "tag": "div",
  "class": "sy-footer-wrapper",
  "enabled_on": {
    "groups": [
      "footer"
    ]
  },
  "settings": [
    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "checkbox",
      "id": "show_logo",
      "label": "Show logo",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Defaults to the circular seal. Upload the transparent seal from the brand package."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 60,
      "max": 280,
      "step": 10,
      "unit": "px",
      "default": 150
    },
    {
      "type": "richtext",
      "id": "brand_text",
      "label": "Short text",
      "default": "<p>Vintage, antique and simply wonderful things, collected one at a time. Local pickup in Sebastian, Florida.</p>"
    },
    {
      "type": "header",
      "content": "Social links"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram"
    },
    {
      "type": "url",
      "id": "facebook_url",
      "label": "Facebook"
    },
    {
      "type": "url",
      "id": "pinterest_url",
      "label": "Pinterest"
    },
    {
      "type": "url",
      "id": "tiktok_url",
      "label": "TikTok"
    },
    {
      "type": "header",
      "content": "Bottom bar"
    },
    {
      "type": "text",
      "id": "copyright_text",
      "label": "Copyright name",
      "info": "Defaults to the store name."
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline (italic)",
      "default": "Beautiful Things Worth Keeping"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_rules",
      "label": "Show gold rule under column titles",
      "default": true
    },
    {
      "type": "header",
      "content": "Colours"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colour scheme",
      "options": [
        {
          "value": "cream",
          "label": "Cream"
        },
        {
          "value": "sage",
          "label": "Light sage"
        },
        {
          "value": "forest",
          "label": "Forest green (dark)"
        },
        {
          "value": "custom",
          "label": "Custom"
        }
      ],
      "default": "forest",
      "info": "Brand colours are set in Theme settings > Subjectively Yours."
    },
    {
      "type": "color",
      "id": "custom_background",
      "label": "Background",
      "default": "#F5EDE1",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_text",
      "label": "Text",
      "default": "#41523F",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_muted",
      "label": "Secondary text",
      "default": "#5B4632",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_accent",
      "label": "Accent rules",
      "default": "#B88D46",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "Button background",
      "default": "#41523F",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "Button text",
      "default": "#F5EDE1",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "color",
      "id": "custom_card_background",
      "label": "Image background",
      "default": "#EFE6D8",
      "visible_if": "{{ section.settings.color_scheme == 'custom' }}"
    },
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "select",
      "id": "content_width",
      "label": "Content width",
      "options": [
        {
          "value": "page",
          "label": "Brand width"
        },
        {
          "value": "narrow",
          "label": "Narrow"
        },
        {
          "value": "wide",
          "label": "Wide"
        },
        {
          "value": "full",
          "label": "Full width"
        }
      ],
      "default": "page"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Top padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 96
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Bottom padding (desktop)",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_top_mobile",
      "label": "Top padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom_mobile",
      "label": "Bottom padding (mobile)",
      "min": 0,
      "max": 160,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "checkbox",
      "id": "reveal",
      "label": "Reveal on scroll",
      "default": false,
      "info": "Also needs Theme settings > Subjectively Yours > Reveal sections on scroll."
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text column",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Visit"
        },
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Local pickup by appointment in Sebastian, Florida.</p>"
        }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "SY Footer",
      "blocks": [
        {
          "type": "menu",
          "settings": {
            "title": "Shop"
          }
        },
        {
          "type": "menu",
          "settings": {
            "title": "Help"
          }
        },
        {
          "type": "text"
        }
      ]
    }
  ]
}
{% endschema %}
