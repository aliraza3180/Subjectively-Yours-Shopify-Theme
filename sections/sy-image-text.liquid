      "default": "The collector"
    },
    {
      "type": "checkbox",
      "id": "show_rule",
      "label": "Show gold rule under label",
      "default": true
    },
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "Heading",
      "default": "A collector's <em>note</em>"
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading size (desktop)",
