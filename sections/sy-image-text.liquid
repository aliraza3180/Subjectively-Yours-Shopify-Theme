{%- render 'sy-base' -%}
<section
  id="sy-{{ section.id }}"
  class="sy-section sy-scheme--{{ section.settings.color_scheme }} sy-image-text"
  style="{% render 'sy-section-style', settings: section.settings %}"
>
  <div class="sy-container{% if section.settings.content_width == 'full' %} sy-container--full{% endif %}{% if settings.sy_reveal and section.settings.reveal %} sy-reveal{% endif %}">

    {%- liquid
      assign s = section.settings
      assign split_img_style = 'object-position: ' | append: s.image.presentation.focal_point
    -%}
    <div
      class="sy-split sy-split--media-{{ s.media_position }} sy-split--align-{{ s.vertical_alignment }}"
      style="--sy-split-media: {{ s.media_width }}%; --sy-media-ratio: {{ s.image_ratio }}; --sy-h-d: {{ s.heading_size }}px; --sy-h-m: {{ s.heading_size_mobile }}px;"
    >
      <div class="sy-split__media sy-media sy-media--ratio">
        {%- if s.image != blank -%}
          <picture>
            {%- if s.image_mobile != blank -%}
              <source media="(max-width: 749px)" srcset="{{ s.image_mobile | image_url: width: 750 }} 750w, {{ s.image_mobile | image_url: width: 1100 }} 1100w" sizes="100vw">
            {%- endif -%}
            {{ s.image | image_url: width: 1600 | image_tag: widths: '500, 750, 1000, 1300, 1600', sizes: '(min-width: 990px) 50vw, 100vw', loading: 'lazy', alt: s.image.alt, style: split_img_style }}
          </picture>
        {%- else -%}
          <img src="{{ 'sy-demo-collector.jpg' | asset_url }}" alt="" loading="lazy" width="1800" height="1200">
        {%- endif -%}
      </div>
      <div class="sy-split__content">
        {%- if s.eyebrow != blank -%}
          <div>
            <p class="sy-eyebrow">{{ s.eyebrow | escape }}</p>
            {%- if s.show_rule -%}
              <span class="sy-rule" aria-hidden="true"></span>
            {%- endif -%}
          </div>
        {%- endif -%}
        {%- if s.heading != blank -%}
          <h2 class="sy-heading">{{ s.heading }}</h2>
        {%- endif -%}
        {%- if s.text != blank -%}
          <div class="sy-text">{{ s.text }}</div>
        {%- endif -%}
        {%- if s.signature != blank -%}
          <p class="sy-split__signature">{{ s.signature | escape }}</p>
        {%- endif -%}
        {%- if s.button_label != blank -%}
          <div class="sy-actions">
            {%- render 'sy-button', label: s.button_label, url: s.button_link, style: s.button_style -%}
          </div>
        {%- endif -%}
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
  .sy-split {
    display: grid;
    gap: 36px;
  }

  @media screen and (min-width: 990px) {
    .sy-split {
      grid-template-columns: var(--sy-split-media) minmax(0, 1fr);
      gap: clamp(48px, 6vw, 104px);
    }

    .sy-split--media-right .sy-split__media {
      order: 2;
    }

    .sy-split--align-top { align-items: start; }
    .sy-split--align-center { align-items: center; }
    .sy-split--align-bottom { align-items: end; }
  }

  .sy-split__content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 22px;
    min-width: 0;
    max-width: 38rem;
  }

  .sy-split__signature {
    margin: 0;
    font-family: var(--sy-font-heading);
    font-size: 22px;
    font-style: italic;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "SY Image with text",
  "tag": "div",
  "settings": [
    {
      "type": "header",
      "content": "Image"
