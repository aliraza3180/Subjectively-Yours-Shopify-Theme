      "id": "image_ratio",
      "label": "Image shape",
      "options": [
        {
          "value": "3 / 2",
          "label": "Landscape (3:2)"
        },
        {
          "value": "4 / 3",
          "label": "Landscape (4:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "4 / 5",
          "label": "Portrait (4:5)"
        },
        {
          "value": "3 / 4",
          "label": "Tall (3:4)"
        }
      ],
      "default": "3 / 2"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position (desktop)",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "left"
    },
    {
      "type": "select",
      "id": "media_width",
      "label": "Image width (desktop)",
      "options": [
        {
          "value": "40",
          "label": "40%"
        },
        {
          "value": "45",
          "label": "45%"
        },
        {
          "value": "50",
          "label": "50%"
        },
        {
          "value": "55",
          "label": "55%"
        },
        {
          "value": "60",
          "label": "60%"
        }
      ],
      "default": "50"
    },
    {
      "type": "select",
      "id": "vertical_alignment",
      "label": "Content vertical alignment",
      "options": [
        {
          "value": "top",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Centre"
        },
        {
          "value": "bottom",
          "label": "Bottom"
        }
      ],
